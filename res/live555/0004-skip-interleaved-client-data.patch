     } else {
+      // ----------------------------------------------------------------
+      // Check for interleaved RTCP data from the client (starts with '$').
+      // In TCP interleaved mode the client sends RTCP receiver reports
+      // framed as: $ <1-byte channel> <2-byte big-endian length> <data>.
+      // Silently skip these without sending a response to avoid CSeq desync.
+      // ----------------------------------------------------------------
+      if (fRequestBuffer[0] == '$' && fRequestBytesAlreadySeen >= 4) {
+        unsigned frameSize = 4 + ((fRequestBuffer[2] << 8) | fRequestBuffer[3]);
